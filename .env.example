# Copy to .env and adjust as needed: cp .env.example .env

# Host port that maps to the container's port 8080
HOST_PORT=8080

# ASP.NET Core hosting environment. "Development" enables the developer
# exception page; leave this as Production for anything but local debugging.
ASPNETCORE_ENVIRONMENT=Production

# Schedule data source. This image only ever supports Csv (offline demo data
# from sample-data/schedule.csv) - it does not ship Chrome/chromedriver, so
# "Live" (the Selenium scraper mode) will not work here.
UNIZAPLUS_DATASOURCE=Csv
