
@page
@model ScheduleExportModel
@{
    ViewData["Title"] = "Export Schedule";
}

<div class="container mt-4">
    <h1 class="mb-4">Export Schedule</h1>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Export Options</h5>
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Format: CSV</label>
                    <input type="hidden" name="format" value="csv">
                </div>

                <button type="submit" class="btn btn-primary">Download Schedule</button>
                <a asp-page="Index" class="btn btn-secondary">Back to Schedule</a>
            </form>
        </div>
    </div>
</div>