@page "{id:int}"
@model ScheduleEditModel
@{
    ViewData["Title"] = Model.IsNewItem ? "Add Schedule Item" : "Edit Schedule Item";
}


<div class="container mt-4">
    <h1 class="mb-4">@(Model.IsNewItem ? "Add New Schedule Item" : "Edit Schedule Item")</h1>

    <div class="card">
        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="ScheduleItem.Id" />
                <input type="hidden" asp-for="ScheduleItem.Color" />

                <div class="mb-3">
                    <label asp-for="ScheduleItem.Day" class="form-label">Day</label>
                    <select asp-for="ScheduleItem.Day" class="form-select">
                        @foreach (var day in Model.Days)
                        {
                            <option value="@day">@day</option>
                        }
                    </select>
                </div>

                <div class="row mb-3">
                    <div class="col">
                        <label asp-for="ScheduleItem.StartHour" class="form-label">Start Time</label>
                        <select asp-for="ScheduleItem.StartHour" class="form-select">
                            @for (int hour = 7; hour <= 20; hour++)
                            {
                                <option value="@hour">@hour:00</option>
                            }
                        </select>
                    </div>
                    <div class="col">
                        <label asp-for="ScheduleItem.Duration" class="form-label">Duration (hours)</label>
                        <select asp-for="ScheduleItem.Duration" class="form-select">
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ScheduleItem.Type" class="form-label">Type</label>
                    <select asp-for="ScheduleItem.Type" class="form-select">
                        <option value="P">Lecture (P)</option>
                        <option value="C">Exercise (C)</option>
                        <option value="L">Laboratory (L)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="ScheduleItem.Subject" class="form-label">Subject</label>
                    <input asp-for="ScheduleItem.Subject" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="ScheduleItem.SubjectCode" class="form-label">Subject Code</label>
                    <input asp-for="ScheduleItem.SubjectCode" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="ScheduleItem.Professor" class="form-label">Professor</label>
                    <input asp-for="ScheduleItem.Professor" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="ScheduleItem.Classroom" class="form-label">Classroom</label>
                    <input asp-for="ScheduleItem.Classroom" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="ScheduleItem.StudentGroups" class="form-label">Student Groups</label>
                    <input asp-for="ScheduleItem.StudentGroups" class="form-control" />
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>