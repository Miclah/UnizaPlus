@page "{id:int}"
@model ScheduleDetailModel
@{
    ViewData["Title"] = "Schedule Item Details";
}
<div class="container mt-4">
    <h1 class="mb-4">Schedule Item Details</h1>

    @if (Model.ScheduleItem != null)
    {
        <div class="card">
            <div class="card-header" style="background-color: @Model.ScheduleItem.Color">
                <h4>@Model.ScheduleItem.Subject (@Model.ScheduleItem.SubjectCode)</h4>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <strong>Professor:</strong>
                    </div>
                    <div class="col-md-8">
                        @Model.ScheduleItem.Professor
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <strong>Classroom:</strong>
                    </div>
                    <div class="col-md-8">
                        @Model.ScheduleItem.Classroom
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <strong>Type:</strong>
                    </div>
                    <div class="col-md-8">
                        @Model.GetClassTypeDescription(Model.ScheduleItem.Type)
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <strong>Time:</strong>
                    </div>
                    <div class="col-md-8">
                        @Model.ScheduleItem.Day, @Model.ScheduleItem.StartHour:00 - @(Model.ScheduleItem.StartHour + Model.ScheduleItem.Duration):00
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <strong>Student Groups:</strong>
                    </div>
                    <div class="col-md-8">
                        @Model.ScheduleItem.StudentGroups
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <a asp-page="Index" class="btn btn-primary">Back to Schedule</a>
                <a asp-page="ScheduleEdit" asp-route-id="@Model.ScheduleItem.Id" class="btn btn-secondary">Edit</a>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            Schedule item not found.
        </div>
        <a asp-page="Index" class="btn btn-primary">Back to Schedule</a>
    }
</div>